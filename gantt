# TUI interactive mode

import re
import curses

def strip_ansi(s):
    return re.sub(r'\033\[[0-9;]*m', '', s)

def edit_entry(stdscr, e, f_date):
    fields = [
        ('key', e.key_string),
        ('duration', str(e.duration)),
        ('shift', str(e.shift)),
        ('value', e.value_string.strip()),
        ('color', e.color or ''),
    ]
    if e.start_date:
        fields.append(('start_date', e.start_date.isoformat()))
    if e.end_date:
        fields.append(('end_date', e.end_date.isoformat()))

    height, width = stdscr.getmaxyx()
    win_h = len(fields) + 4
    win_w = min(60, width - 4)
    win_y = (height - win_h) // 2
    win_x = (width - win_w) // 2

    win = curses.newwin(win_h, win_w, win_y, win_x)
    win.box()
    win.addstr(0, 2, " Edit entry (Tab/Shift+Tab: next field, Esc: cancel, Enter: save) ")

    cur_field = 0
    vals = [v for _, v in fields]
    while True:
        for i, (name, _) in enumerate(fields):
            y = 2 + i
            label = f" {name}: "
            win.addstr(y, 2, label)
            val = vals[i]
            if i == cur_field:
                win.attron(curses.A_REVERSE)
                win.addstr(y, 2 + len(label), val + ' ' * max(0, win_w - 4 - len(label) - len(val)))
                win.attroff(curses.A_REVERSE)
            else:
                win.addstr(y, 2 + len(label), val + ' ' * max(0, win_w - 4 - len(label) - len(val)))
        win.refresh()

        key = stdscr.getch()
        if key == 27:  # Esc
            return False
        elif key == ord('\n') or key == ord('\r'):
            break
        elif key == ord('\t'):
            cur_field = (cur_field + 1) % len(fields)
        elif key == curses.KEY_BTAB:
            cur_field = (cur_field - 1) % len(fields)
        elif key == curses.KEY_UP:
            cur_field = (cur_field - 1) % len(fields)
        elif key == curses.KEY_DOWN:
            cur_field = (cur_field + 1) % len(fields)
        elif key in [curses.KEY_BACKSPACE, 127, 8]:
            vals[cur_field] = vals[cur_field][:-1]
        elif 32 <= key <= 126:
            vals[cur_field] += chr(key)

    # Apply edited values
    e.key_string = vals[0]
    try:
        e.duration = int(vals[1]) if vals[1] else 0
    except ValueError:
        pass
    try:
        e.shift = int(vals[2]) if vals[2] else 0
    except ValueError:
        pass
    e.value_string = ' ' + vals[3] if vals[3] else ''
    e.color = vals[4].upper() if vals[4] else None

    field_idx = 5
    if e.start_date is not None or (field_idx < len(vals) and vals[field_idx]):
        if field_idx < len(vals) and vals[field_idx]:
            try:
                e.start_date = date.fromisoformat(vals[field_idx])
            except ValueError:
                pass
        field_idx += 1
    else:
        if field_idx < len(fields):
            field_idx += 1
    if e.end_date is not None or (field_idx < len(vals) and vals[field_idx]):
        if field_idx < len(vals) and vals[field_idx]:
            try:
                e.end_date = date.fromisoformat(vals[field_idx])
            except ValueError:
                pass

    del win
    return True


def serialize_entry(e):
    if e.type == 'divider':
        return '---'
    if e.type == 'divider-header':
        return '---h'
    if e.type == 'heading':
        return e.key_string + break_char
    parts = []
    if e.duration:
        parts.append(str(e.duration))
    if e.shift:
        parts.append(f'{e.shift:+d}')
    if e.highlight_len:
        parts.append(f'/{e.highlight_len}')
    if e.start_date:
        parts.append(f'^{e.start_date.isoformat()}')
    if e.end_date:
        parts.append(f'${e.end_date.isoformat()}')
    if e.color:
        parts.append(f'@{e.color}')
    if e.value_string:
        parts.append(e.value_string.strip())
    return f'{e.key_string}{break_char} {" ".join(parts)}'


def run_tui(stdscr, entries, f_date, header_modulo, modulo_shift, max_key_len):
    curses.curs_set(0)
    ansi_pair = {
        '91': 1, '92': 2, '93': 3, '94': 4, '96': 5, '95': 6, '36': 5,
    }
    ansi_attr = {
        '1': curses.A_BOLD, '2': curses.A_DIM, '4': curses.A_UNDERLINE, '7': curses.A_REVERSE,
    }
    bright_codes = {'91', '92', '93', '94', '95', '96'}

    def render_line(y, x, raw, width):
        i = 0
        pair = 0
        attrs = 0
        while i < len(raw) and x < width:
            if raw[i] == '\033' and i + 1 < len(raw) and raw[i + 1] == '[':
                j = i + 2
                while j < len(raw) and raw[j] != 'm':
                    j += 1
                if j < len(raw):
                    codes = raw[i + 2:j].split(';')
                    for code in codes:
                        if code == '0':
                            pair = 0
                            attrs = 0
                        elif code in ansi_pair:
                            pair = ansi_pair[code]
                            if code in bright_codes:
                                attrs |= curses.A_BOLD
                            else:
                                attrs &= ~curses.A_BOLD
                        elif code in ansi_attr:
                            attrs |= ansi_attr[code]
                    i = j + 1
                    continue
            if ord(raw[i]) >= 32:
                if pair:
                    stdscr.attrset(curses.color_pair(pair) | attrs)
                elif attrs:
                    stdscr.attrset(attrs)
                else:
                    stdscr.attrset(0)
                stdscr.addch(y, x, raw[i])
                x += 1
            i += 1
        stdscr.attrset(0)

    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_RED, -1)
        curses.init_pair(2, curses.COLOR_GREEN, -1)
        curses.init_pair(3, curses.COLOR_YELLOW, -1)
        curses.init_pair(4, curses.COLOR_BLUE, -1)
        curses.init_pair(5, curses.COLOR_CYAN, -1)
        curses.init_pair(6, curses.COLOR_MAGENTA, -1)

    selected = 0
    lines_cache = []
    header_lines = 0
    undo_stack = []
    status_msg = ''

    def push_undo():
        undo_stack.append(copy.deepcopy(entries))

    def save_file():
        with open(args.filename, 'w') as f:
            f.write('# Generated by gantt-py interactive mode\n')
            if f_date:
                f.write(f'- START: {f_date.isoformat()}\n')
            if header_modulo != 7:
                f.write(f'- MODULO: {header_modulo}\n')
            if modulo_shift != 0:
                f.write(f'- MODULO_SHIFT: {modulo_shift}\n')
            if break_char != ':':
                f.write(f'- BREAK_CHAR: {break_char}\n')
            f.write('\n')
            for e in entries:
                f.write(serialize_entry(e) + '\n')

    def build_lines():
        nonlocal lines_cache, header_lines
        header_top, header_bottom, _ = process_and_render(
            entries, f_date, header_modulo, modulo_shift, max_key_len
        )
        header_lines = header_top.count('\n') + 1
        lines_cache = []
        for line in header_top.split('\n'):
            lines_cache.append(line)
        for e in entries:
            lines_cache.append(e.output_string)
        for line in header_bottom.split('\n'):
            lines_cache.append(line)

    build_lines()

    while True:
        height, width = stdscr.getmaxyx()
        stdscr.clear()

        display_lines = len(lines_cache)
        max_scroll = max(0, display_lines - (height - 1))
        scroll = max(0, selected - (height - 1) // 2)
        scroll = min(scroll, max_scroll)
        selected_global = header_lines + selected

        for i in range(height - 1):
            idx = i + scroll
            if idx >= display_lines:
                break
            raw = lines_cache[idx]
            if idx == selected_global:
                stdscr.attron(curses.A_REVERSE)
                stdscr.addstr(i, 0, strip_ansi(raw)[:width - 1])
                stdscr.attroff(curses.A_REVERSE)
            elif idx == 0 or idx == display_lines - 1:
                stdscr.attron(curses.A_DIM)
                stdscr.addstr(i, 0, strip_ansi(raw)[:width - 1])
                stdscr.attroff(curses.A_DIM)
            else:
                render_line(i, 0, raw, width - 1)

        mode = status_msg if status_msg else 'VIEW'
        status_msg = ''
        status = f" {mode}  |  j/k: navigate  i: edit  s: save  u: undo  q: quit  |  entry {selected+1}/{len(entries)}"
        stdscr.attron(curses.A_REVERSE)
        stdscr.addstr(height - 1, 0, status + ' ' * max(0, width - 1 - len(status)))
        stdscr.attroff(curses.A_REVERSE)

        key = stdscr.getch()
        if key == ord('q'):
            break
        elif key == ord('j') or key == curses.KEY_DOWN:
            selected = min(selected + 1, len(entries) - 1)
        elif key == ord('k') or key == curses.KEY_UP:
            selected = max(selected - 1, 0)
        elif key == ord('g'):
            selected = 0
        elif key == ord('G'):
            selected = len(entries) - 1
        elif key == ord('i'):
            e = entries[selected]
            push_undo()
            curses.curs_set(1)
            changed = edit_entry(stdscr, e, f_date)
            curses.curs_set(0)
            if changed:
                build_lines()
            stdscr.clear()
            stdscr.refresh()
        elif key == ord('o'):
            push_undo()
            new_e = entry()
            new_e.key_string = 'new'
            new_e.duration = 1
            entries.insert(selected + 1, new_e)
            selected += 1
            build_lines()
        elif key == ord('O'):
            push_undo()
            new_e = entry()
            new_e.key_string = 'new'
            new_e.duration = 1
            entries.insert(selected, new_e)
            build_lines()
        elif key == ord('d'):
            nkey = stdscr.getch()
            if nkey == ord('d') and len(entries) > 1:
                push_undo()
                del entries[selected]
                if selected >= len(entries):
                    selected = len(entries) - 1
                build_lines()
        elif key == ord('s'):
            save_file()
            status_msg = 'SAVED'
        elif key == ord('u'):
            if undo_stack:
                entries[:] = copy.deepcopy(undo_stack.pop())
                selected = min(selected, len(entries) - 1)
                build_lines()
                status_msg = 'UNDO'
        elif key == ord('r'):
            build_lines()
        elif key == ord('n'):
            build_lines()
        elif key == ord('h'):
            pass
        elif key == ord('l'):
            pass


